<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <link rel="icon" href="data:," />
    <ResourcePreloader />
    <link rel="stylesheet" href="_content/Microsoft.FluentUI.AspNetCore.Components/css/reboot.css" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["DevOpsBlazor.Web.styles.css"]" />
    <ImportMap />
    <HeadOutlet @rendermode="RenderMode" />
</head>

<body>
    <Routes @rendermode="RenderMode" />
    <ReconnectModal />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
    <script>
        window.devopsBlazor = {
            copy: text => navigator.clipboard.writeText(text)
        };
    </script>
</body>

</html>

@code {
    // No prerendering: every page loads its Azure DevOps data once, after the circuit connects.
    private static readonly IComponentRenderMode RenderMode = new InteractiveServerRenderMode(prerender: false);
}
