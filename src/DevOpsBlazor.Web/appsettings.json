{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System.Net.Http.HttpClient": "Warning",
      "Polly": "Warning"
    }
  },
  // Only answer requests addressed to this machine.
  "AllowedHosts": "localhost;127.0.0.1",

  "AzureDevOps": {
    // e.g. "https://dev.azure.com/contoso". The PAT goes in user-secrets, never here (see README).
    "Organization": "",
    // Projects to include. Leave empty for every project the PAT can see.
    "Projects": [],
    "RunsPerPipeline": 20,
    "CacheMinutes": { "Pipelines": 10, "Runs": 1, "Policies": 10 }
  },

  "RunLabels": {
    "SlowFactor": 1.5,
    "SlowerTrendFactor": 1.25,
    "LongQueueMinutes": 10,
    "FlakyFlipsThreshold": 3,
    "StaleDays": 30,
    "MinSamples": 3
  },

  "Compliance": {
    "BaselineFile": "compliance-baseline.json"
  }
}
